{
  "name": "beetle",
  "productName": "BEep",
  "version": "2.2.1",
  "description": "BEep for your computer: find Jibo on your network, open BEacon in the 5x1 look, convert a modded Jibo to 5x1, and switch Jibo to int-developer or back him up over USB.",
  "main": "main.js",
  "author": "Zane V <zane@jiborevival.com>",
  "license": "AGPL-3.0-only",
  "homepage": "https://5x1.com",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "electron . --check",
    "dist": "electron-builder --publish never"
  },
  "dependencies": {
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.jiborevival.beetle",
    "productName": "BEep",
    "files": [
      "main.js",
      "finder.js",
      "conversion.js",
      "updater.js",
      "preload.js",
      "page-preload.js",
      "ui/**",
      "web/**",
      "build/icon.png",
      "LICENSE",
      "!node_modules/cpu-features/**",
      "!node_modules/buildcheck/**",
      "!node_modules/nan/**",
      "!node_modules/ssh2/lib/protocol/crypto/build/**",
      "!node_modules/ssh2/lib/protocol/crypto/src/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "BEep-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "extraResources": [
        {
          "from": "dfu/dist/beep-dfu",
          "to": "dfu-x64"
        }
      ]
    },
    "nsis": {
      "oneClick": true
    },
    "portable": {
      "artifactName": "BEep-${version}-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "extraResources": [
        {
          "from": "dfu/dist/beep-dfu-arm64",
          "to": "dfu-arm64"
        },
        {
          "from": "dfu/dist/beep-dfu-x64",
          "to": "dfu-x64"
        }
      ],
      "x64ArchFiles": "Contents/Resources/dfu-*/**"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "extraResources": [
        {
          "from": "dfu/dist/beep-dfu",
          "to": "dfu-x64"
        }
      ]
    },
    "npmRebuild": false
  },
  "desktopName": "BEep.desktop"
}
